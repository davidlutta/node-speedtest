    {
      "type": "timeseries",
      "title": "Download by region",
      "description": "Throughput to each region. Divergence between regions points at international transit rather than your local line.",
      "datasource": {
        "type": "influxdb",
        "uid": "speedtest-influx"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Mbits",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "showPoints": "auto",
            "pointSize": 5,
            "spanNulls": true,
            "axisPlacement": "auto",
            "scaleDistribution": {
