{
  "uid": "speedtest-main",
  "title": "Internet Speed",
  "description": "Ookla Speedtest results across regions, collected on a schedule",
  "tags": [
    "speedtest",
    "network"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {},
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "speedtest-influx"
        },
        "query": "SHOW TAG VALUES FROM \"internetspeed\" WITH KEY = \"host\"",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 1
      },
      {
        "name": "region",
        "label": "Region",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "speedtest-influx"
        },
        "query": "SHOW TAG VALUES FROM \"internetspeed\" WITH KEY = \"region\"",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Download",
      "description": "Latest download speed per region",
      "datasource": {
        "type": "influxdb",
        "uid": "speedtest-influx"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Mbits",
          "decimals": 1,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 20
              },
              {
                "color": "green",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "speedtest-influx"
          },
          "query": "SELECT last(\"downloadSpeed\") FROM \"internetspeed\" WHERE (\"host\" =~ /^$host$/ AND \"region\" =~ /^$region$/) AND $timeFilter GROUP BY \"region\"",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
