          "query": "SELECT mean(\"downloadSpeed\") AS \"Download\" FROM \"internetspeed\" WHERE (\"host\" =~ /^$host$/ AND \"region\" =~ /^$region$/) AND $timeFilter GROUP BY time($__interval), \"region\" fill(none)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
