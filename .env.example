# ---------------------------------------------------------------------------
# InfluxDB 2.x
# ---------------------------------------------------------------------------
# These credentials are used BOTH for the 2.x admin account and for the
# v1-compatibility user the app authenticates with (see scripts/influxdb-init).
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=your_secure_password_here   # must be at least 8 characters

# Admin API token. Generate one with: openssl rand -hex 32
INFLUXDB_ADMIN_TOKEN=your_generated_admin_token_here

INFLUXDB_ORG=speedtest
INFLUXDB_DATABASE=internetspeed
INFLUXDB_RETENTION=52w
INFLUXDB_PORT=8086

# Set to true ONLY when pointing at a legacy InfluxDB 1.x server, which allows
# the app to CREATE DATABASE itself. InfluxDB 2.x forbids this.
INFLUX_MANAGE_DB=false

# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------
GRAFANA_PASSWORD=your_secure_grafana_password_here

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=production
# Every 4 hours. See the data-usage warning above before shortening this.
CRON_SCHEDULE=0 */4 * * *
CRON_TIMEZONE=Africa/Nairobi

# Optional: Customize host tag for InfluxDB measurements (defaults to hostname)
SPEEDTEST_HOST_TAG=raspberrypi

# Abort a speed test that has not finished within this many milliseconds.
SPEEDTEST_TIMEOUT_MS=120000

# Servers to test against, as a comma separated list of `label:id` pairs.
# Every server is tested once per cron tick, in sequence, and tagged with its
# label so regions can be compared on one graph.
#
# WARNING: each test moves roughly 130 MB. Five servers every 15 minutes is
# about 63 GB per DAY. Pick CRON_SCHEDULE accordingly -- see the README.
#
# Find more with: docker compose exec speedtest speedtest --servers
# or search any city at https://www.speedtest.net/api/js/servers?search=CITY
SPEEDTEST_SERVERS=Nairobi:14389,Johannesburg:23339,Frankfurt:31448,Dubai:17336,Ashburn:14229

# Legacy single-server pin. Ignored when SPEEDTEST_SERVERS is set; leave both
# blank to let the CLI auto-select the nearest server.
SPEEDTEST_SERVER_ID=

# Tags each InfluxDB point with the backend that produced it, so older
# fast.com data stays distinguishable from Ookla data on the same panel.
SPEEDTEST_SOURCE=ookla

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
# arm64 / amd64 (64-bit Raspberry Pi OS): node:24-trixie-slim
# armv7        (32-bit Raspberry Pi OS): node:22-bookworm-slim
NODE_IMAGE=node:24-trixie-slim
